# ─── MASDojo environment ──────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# ── Core security secrets ──
# JWT signing secret. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=120

# Master key used to encrypt per-user BYOK API keys at rest (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=change-me-fernet-key

# ── Database ──
POSTGRES_USER=masdojo
POSTGRES_PASSWORD=masdojo
POSTGRES_DB=masdojo
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://masdojo:masdojo@db:5432/masdojo

# ── Redis (grading job queue) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
GRADING_QUEUE=masdojo:grading

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
# Comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173

# ── Deployment mode ──
# SOLO_MODE=true runs MASDojo for a single local participant: no login, a single
# implicit local profile, straight into the curriculum. Use for the workshop /
# self-hosted-on-your-own-laptop model. Keep false for a shared multi-user host.
SOLO_MODE=false
# Per-install salt mixed into seeded-challenge targets so each participant's
# secrets differ even in solo mode. `make env` fills this with a random value.
INSTALL_SALT=

# ── Frontend ──
VITE_API_BASE_URL=http://localhost:8000

# ── Runner ──
# Hard timeout for a single grading job, seconds.
GRADING_JOB_TIMEOUT_SEC=420
# Name of the Android Virtual Device the runner boots.
AVD_NAME=masdojo_avd
# Android SDK location inside the runner image.
ANDROID_SDK_ROOT=/opt/android-sdk
# Frida server version pushed to the AVD (keep in sync with the frida client).
FRIDA_VERSION=16.4.8
# mitmproxy listen port used for network_assert capture.
MITM_PORT=8081
