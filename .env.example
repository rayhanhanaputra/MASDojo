# ─── MASDojo environment ──────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.

# ── Core security secrets ──
# JWT signing secret. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=120

# Master key used to encrypt per-user BYOK API keys at rest (Fernet).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=change-me-fernet-key

# ── Database ──
POSTGRES_USER=masdojo
POSTGRES_PASSWORD=masdojo
POSTGRES_DB=masdojo
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://masdojo:masdojo@db:5432/masdojo

# ── Redis (grading job queue) ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
GRADING_QUEUE=masdojo:grading

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
# Comma-separated CORS origins for the frontend dev server.
CORS_ORIGINS=http://localhost:5173

# ── Deployment mode ──
# SOLO_MODE=true runs MASDojo for a single local participant: no login, a single
# implicit local profile, straight into the curriculum. Use for the workshop /
# self-hosted-on-your-own-laptop model. Keep false for a shared multi-user host.
SOLO_MODE=false
# Per-install salt mixed into seeded-challenge targets so each participant's
# secrets differ even in solo mode. `make env` fills this with a random value.
INSTALL_SALT=

# ── AI mentor (BYOK) ──
# The mentor normally uses each user's own key entered in-app (Settings → AI
# Key), stored encrypted at rest. The settings below are install-level options.
#
# Point the Anthropic provider at a custom Anthropic-compatible endpoint
# (proxy / LLM gateway). The provider appends `/v1/messages`. Leave as the
# official API for standard BYOK.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model id sent to the endpoint (must be one the endpoint accepts).
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional install-level key used ONLY as a fallback when a user has not set
# their own in-app — convenient for SOLO_MODE / workshop demos. Leave empty for
# pure per-user BYOK. NEVER commit a real key (this file is .env, gitignored).
ANTHROPIC_API_KEY=
#
# The OpenAI provider works the same way and also drives any OpenAI-COMPATIBLE
# gateway/proxy (the provider appends `/v1/chat/completions` and sends
# stream:false). Point OPENAI_BASE_URL at the gateway origin and set OPENAI_MODEL
# to a model it serves. When OPENAI_API_KEY is set it is preferred over
# ANTHROPIC_API_KEY as the install-level mentor fallback.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=

# ── Frontend ──
VITE_API_BASE_URL=http://localhost:8000

# ── Runner ──
# Hard timeout for a single grading job, seconds.
GRADING_JOB_TIMEOUT_SEC=420
# Name of the Android Virtual Device the runner boots.
AVD_NAME=masdojo_avd
# Android SDK location inside the runner image.
ANDROID_SDK_ROOT=/opt/android-sdk
# Frida server version pushed to the AVD (keep in sync with the frida client).
FRIDA_VERSION=16.4.8
# mitmproxy listen port used for network_assert capture.
MITM_PORT=8081
